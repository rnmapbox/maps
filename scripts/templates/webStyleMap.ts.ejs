<%
  const layers = locals.layers;
  const nonLayerNames = ['light', 'atmosphere', 'snow', 'rain', 'terrain'];
-%>
// DO NOT MODIFY
// THIS FILE IS AUTOGENERATED

export const layerStyleProps: {
  [name: string]: { name: string; kind: 'paint' | 'layout' };
} = {
  <%_ const seenProps = new Set(); _%>
  <%_ for (let layer of layers.filter((l) => !nonLayerNames.includes(l.name))) { _%>
  <%_ for (let prop of layer.properties) { _%>
  <%_ if (!seenProps.has(prop.name)) { _%>
  <%_ seenProps.add(prop.name); _%>
  <%= prop.name %>: { name: '<%= prop.mbx.name %>', kind: '<%= prop.mbx.namespace %>' },
  <%_ } _%>
  <%_ } _%>
  <%_ } _%>
};

export const styleObjectProps: {
  [object: string]: { [name: string]: string };
} = {
  <%_ for (let layer of layers.filter((l) => nonLayerNames.includes(l.name))) { _%>
  <%= layer.name %>: {
    <%_ for (let prop of layer.properties) { _%>
    <%= prop.name %>: '<%= prop.mbx.name %>',
    <%_ } _%>
  },
  <%_ } _%>
};
